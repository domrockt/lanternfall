      if (b.tick > 0) continue;
      b.tick = 0.25;
      for (const e of ctx.enemies) {
        if (!e.alive || e.hp <= 0) continue;
        if ((e.x - b.x) ** 2 + (e.y - b.y) ** 2 > (b.r + e.radius) ** 2) continue;
        const killed = this.hitEnemy(e, Math.round(b.dps * 0.25), ctx, b.weaponId);
