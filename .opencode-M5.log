1	/**
     2	 * M5-Effekt-Frames: handgesetzte, prozedurale Pixel-Frames (4–8 je Effekt).
     3	 * Laufzeit-Assets entstehen ausschließlich hier (TS-Generator), keine Downloads.
     4	 *
     5	 * Jeder Effekt hat: hellen Kern (13/12), Glow-Halo, Farbrampe und deutliche
     6	 * Masse. Die Frames werden als eigene Texturen `key`, `key_2`, … registriert.
     7	 */
     8	import Phaser from "phaser";
     9	import { PAL } from "../palette";
    10	
    11	interface FxDef {
    12	  w: number;
    13	  h: number;
    14	  frames: string[][];
    15	}
    16	
    17	const hex = (i: number): string => "#" + PAL[i].toString(16).padStart(6, "0");
    18	
    19	function addFrame(scene: Phaser.Scene, key: string, rows: string[], w: number, h: number): void {
    20	  if (scene.textures.exists(key)) return;
    21	  const canvas = document.createElement("canvas");
    22	  canvas.width = w;
    23	  canvas.height = h;
    24	  const ctx = canvas.getContext("2d")!;
    25	  ctx.imageSmoothingEnabled = false;
    26	  for (let y = 0; y < h; y++) {
    27	    const row = rows[y] ?? "";
    28	    for (let x = 0; x < w; x++) {
    29	      const ch = row[x];
    30	      if (!ch || ch === ".") continue;
